{
  "hosting": [
    {
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "rewrites": [
        {
          "source": "/join/**",
          "destination": "/join.html"
        },
        {
          "source": "/play/quick",
          "destination": "/play/index.html"
        },
        {
          "source": "/play/room/**",
          "destination": "/play/index.html"
        },
        {
          "source": "/play/result",
          "destination": "/play/index.html"
        }
      ],
      "headers": [
        {
          "source": "/.well-known/**",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/play/@(quick|result)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/play/room/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/play/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/play/Build/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/admin/**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "Cache-Control",
              "value": "no-store"
            }
          ]
        }
      ],
      "target": "main"
    },
    {
      "target": "old",
      "public": "old-site",
      "ignore": [
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "https://tuitiontakkar.web.app/",
          "type": 301
        },
        {
          "source": "/index.html",
          "destination": "https://tuitiontakkar.web.app/",
          "type": 301
        },
        {
          "source": "/join.html",
          "destination": "https://tuitiontakkar.web.app/",
          "type": 301
        },
        {
          "source": "/privacy",
          "destination": "https://tuitiontakkar.web.app/privacy",
          "type": 301
        },
        {
          "source": "/privacy.html",
          "destination": "https://tuitiontakkar.web.app/privacy",
          "type": 301
        },
        {
          "source": "/join/:code",
          "destination": "https://tuitiontakkar.web.app/join/:code",
          "type": 301
        },
        {
          "source": "/play",
          "destination": "https://tuitiontakkar.web.app/play/",
          "type": 301
        },
        {
          "source": "/play/:a",
          "destination": "https://tuitiontakkar.web.app/play/:a",
          "type": 301
        },
        {
          "source": "/play/:a/:b",
          "destination": "https://tuitiontakkar.web.app/play/:a/:b",
          "type": 301
        },
        {
          "source": "/play/:a/:b/:c",
          "destination": "https://tuitiontakkar.web.app/play/:a/:b/:c",
          "type": 301
        },
        {
          "source": "/admin/:a",
          "destination": "https://tuitiontakkar.web.app/admin/:a",
          "type": 301
        }
      ],
      "headers": [
        {
          "source": "/.well-known/**",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      ]
    }
  ]
}
