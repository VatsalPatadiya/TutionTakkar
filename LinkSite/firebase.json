{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/node_modules/**"],
    "cleanUrls": true,
    "rewrites": [
      { "source": "/join/**", "destination": "/join.html" }
    ],
    "headers": [
      {
        "source": "/.well-known/**",
        "headers": [{ "key": "Content-Type", "value": "application/json" }]
      }
    ]
  }
}
